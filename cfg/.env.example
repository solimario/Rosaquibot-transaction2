# ============================ Variables de Base de Datos ============================
export DB_HOST=tu_host_mysql
export DB_USER=tu_usuario_mysql
export DB_PASS=tu_contraseña_mysql
export DB_NAME=tu_base_de_datos

# ============================ Variables de Portal Claro (Pretups) ============================
export CLARO_USER=tu_usuario_claro
export CLARO_PASS=tu_contraseña_claro

# ============================ Variables de Correo (Gmail SMTP) ============================
# Requiere "Contraseña de aplicación" de Google (no la contraseña normal de Gmail)
# Activar en: myaccount.google.com → Seguridad → Contraseñas de aplicación
export MAIL_REMITENTE="tu_correo@gmail.com"
export SMTP_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# ============================ SharePoint Sync (opcional) ============================
# Usa Microsoft Graph API. No requiere rclone.
# Crear App Registration en portal.azure.com → Microsoft Entra ID → App registrations
# Permisos necesarios: Sites.ReadWrite.All (Application)
# ONEDRIVE_SYNC=true   → activa el sync al final de cada ejecución
# SP_REMOTE_PATH       → carpeta destino dentro de la librería Documents de SharePoint
export ONEDRIVE_SYNC=false
export SP_TENANT_ID=tu_directory_id
export SP_CLIENT_ID=tu_application_client_id
export SP_CLIENT_SECRET=tu_client_secret
export SP_DRIVE_ID=id_de_la_libreria_documents
export SP_REMOTE_PATH=Rosaquibot/transferencias-internas
